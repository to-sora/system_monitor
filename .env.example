# System Monitor Configuration
# Copy this file to .env and fill in your values

# ==============================================================================
# Server Configuration
# ==============================================================================
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# ==============================================================================
# SSL/TLS Configuration
# ==============================================================================
SSL_KEY_PATH=./server.key
SSL_CERT_PATH=./server.cert

# ==============================================================================
# Database Configuration
# ==============================================================================
# Path to SQLite database file
DB_PATH=./data/system_monitor.db

# Database encryption key (32+ characters recommended)
# Generate with: openssl rand -hex 32
DB_ENCRYPTION_KEY=your_very_secure_encryption_key_here_minimum_32_chars

# ==============================================================================
# Authentication Configuration
# ==============================================================================
# JWT secret for token signing (32+ characters recommended)
# Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters

# JWT token expiry (e.g., '7d', '24h', '30m')
JWT_EXPIRY=7d

# ==============================================================================
# Security Configuration
# ==============================================================================
# CORS allowed origin (use specific domain in production)
CORS_ORIGIN=https://yourdomain.com

# IP Whitelist (comma-separated, or '*' for all)
# ALLOWED_IPS=192.168.1.100,192.168.1.101

# ==============================================================================
# Backup Configuration
# ==============================================================================
# Enable automatic backups (true/false)
ENABLE_AUTO_BACKUP=true

# Backup interval in hours
BACKUP_INTERVAL_HOURS=6

# Backup retention in days
BACKUP_RETENTION_DAYS=7

# Backup directory path
BACKUP_DIR=./backups

# ==============================================================================
# Upload Script Configuration (for Python client)
# ==============================================================================
# API endpoint
SYSTEM_MONITOR_API_URL=https://localhost:3000/api

# Authentication credentials
SYSTEM_MONITOR_USERNAME=your_username
SYSTEM_MONITOR_PASSWORD=your_secure_password

# Device identifier
SYSTEM_MONITOR_DEVICE_ID=01

# Upload interval in seconds
SYSTEM_MONITOR_INTERVAL=5

# Network interface (auto or specific like eth0, wlp10s0)
SYSTEM_MONITOR_NETWORK_INTERFACE=auto

# CPU temperature sensor path
SYSTEM_MONITOR_CPU_TEMP_PATH=/sys/class/hwmon/hwmon0/temp1_input

# SSL verification (true/false)
SYSTEM_MONITOR_SSL_VERIFY=true

# Custom SSL certificate path (if using self-signed)
# SYSTEM_MONITOR_SSL_CERT=./server.cert

# ==============================================================================
# Logging Configuration
# ==============================================================================
# Log level (error, warn, info, debug)
LOG_LEVEL=info

# ==============================================================================
# Data Retention Configuration
# ==============================================================================
# Number of days to keep data (90 = 3 months)
DATA_RETENTION_DAYS=90
